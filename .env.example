# polymaker secrets — copy to `.env` and fill in. Never commit `.env`.
#   cp .env.example .env
# Loaded by pydantic-settings (python-dotenv); see src/polymaker/config.py:Secrets.
# Everything else lives in TOML under config/ (config.toml, strategy.toml, markets.toml).

# --- Required for live trading (paper mode also reads these) ---

# Private key of your SIGNING wallet (hex, with or without 0x).
# For proxy wallets (signature_type 1/2/3) this is the signer EOA, NOT the
# deposit address. Never share it; it never leaves this machine (see audit).
PK=

# Your Polymarket deposit address (shown on the profile / developer page).
# For signature_type 1/2/3 this is the DEPOSIT address (the funder that holds
# your pUSD), NOT the signing EOA and NOT the deployer/factory.
BROWSER_ADDRESS=

# --- Optional ---

# Overrides config.toml [wallet] polygon_rpc if set.
#POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

# Discord/other webhook for alerts (see code for the exact payload).
#ALERT_WEBHOOK_URL=

# Builder API credentials — only needed for signature_type 1/3 (V2 DepositWallet)
# merges via the relayer (merge.py, gasless). Self-generate ONCE via the SDK's
# L2-authenticated endpoint (see merge.py docstring), then paste the values here:
#   from py_clob_client_v2.client import ClobClient
#   c = ClobClient("https://clob.polymarket.com", key="<PK>",
#                  chain_id=137, signature_type=3)   # L2 creds via c.create_or_derive_api_key()
#   print(c.create_builder_api_key())   # -> {key, secret, passphrase}
# (The secret is only ever used locally to HMAC-sign request headers.)
#POLY_BUILDER_KEY=
#POLY_BUILDER_SECRET=
#POLY_BUILDER_PASSPHRASE=

# Builder relayer endpoint (default is Polymarket's official relayer).
#POLY_RELAYER_URL=https://relayer-v2.polymarket.com

# Optional: route ALL outbound traffic through a proxy (httpx, web3, requests
# all honor these). E.g. an SSH tunnel: ALL_PROXY=socks5h://127.0.0.1:1080
#ALL_PROXY=
